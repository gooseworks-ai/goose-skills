{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gooseworks.ai/schemas/parts-index.schema.json",
  "title": "parts/index.json",
  "description": "Every published part version. Written by scripts/build-parts-index.js from parts/<id>/<x.y.z>/, checked by scripts/check-parts.js. The server builds each video's parts lock from it.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "version", "interface", "kind", "kit", "needs", "cost", "determinism", "path", "files"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64 },
      "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
      "interface": { "type": "integer", "minimum": 1 },
      "kind": {
        "type": "string",
        "enum": ["generate_voice", "generate_image", "generate_video", "generate_music", "generate_sfx", "render_html", "compose", "caption", "mix", "check", "end_card"]
      },
      "layer": { "type": "string", "enum": ["brand", "captions", "sound", "check"] },
      "kit": { "type": "string" },
      "needs": { "type": "object" },
      "cost": { "type": "object" },
      "determinism": { "type": "string", "enum": ["pure", "seeded", "provider"] },
      "path": { "type": "string", "pattern": "^parts/[a-z][a-z0-9-]*/(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" },
      "files": {
        "description": "sha256 (hex) of every file in the version folder, part.json included, keyed by path relative to the folder.",
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "required": ["part.json"]
      }
    },
    "additionalProperties": false
  }
}
