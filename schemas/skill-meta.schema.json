{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athina.ai/schemas/skill-meta.schema.json",
  "type": "object",
  "required": ["slug", "category", "tags", "installation"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "category": { "type": "string", "enum": ["capabilities", "composites", "playbooks"] },
    "domain": {
      "type": "string",
      "enum": ["ads", "brand", "competitive-intel", "content", "design", "lead-generation", "monitoring", "outreach", "research", "research-tools", "sales", "seo", "social"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "enum": ["All", "ads", "brand", "competitive-intel", "content", "design", "lead-generation", "monitoring", "outreach", "research", "research-tools", "sales", "seo", "social"] },
      "uniqueItems": true
    },
    "installation": {
      "type": "object",
      "required": ["base_command", "supports"],
      "properties": {
        "base_command": { "type": "string", "minLength": 1 },
        "supports": {
          "type": "array",
          "items": { "type": "string", "enum": ["claude", "cursor", "codex"] },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "github_url": { "type": "string" },
    "author": { "type": "string" },
    "example_prompt": { "type": "string" },
    "requires_skills": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "requires_tools": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "version": {
      "description": "Semver of the skill. Every video atom has one; a change to the atom raises it (scripts/check-atom-versions.js).",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "lint_allow": {
      "description": "Atom lint findings that are creative content, not instructions (scripts/atom-lint.js).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "match", "reason"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "match": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
