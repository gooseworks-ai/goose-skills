{
  "name": "goose-skills",
  "version": "1.0.1",
  "description": "GooseWorks skills catalog: marketing playbooks and video skills. Install with npx goose-skills install <slug>",
  "bin": {
    "goose-skills": "./bin/goose-skills.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gooseworks-ai/goose-skills"
  },
  "scripts": {
    "test": "node --test test/*.test.js scripts/__tests__/build-index.test.js scripts/__tests__/validate-skills.test.js",
    "build:index": "node scripts/build-index.js",
    "validate:skills": "node scripts/validate-skills.js",
    "ci": "npm run validate:skills && npm run build:index && node scripts/check-skill-links.js && npm test",
    "test:parts": "node --test parts/_tools/*.test.mjs parts/_lib/*.test.mjs parts/*/tests/*.test.mjs"
  },
  "keywords": [
    "claude-code",
    "skills",
    "marketing",
    "video",
    "ads",
    "gooseworks"
  ],
  "author": "GooseWorks",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "js-yaml": "^4.1.1"
  },
  "files": [
    "bin/"
  ]
}
