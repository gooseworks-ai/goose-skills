{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "sfx-elevenlabs",
  "version": "1.0.1",
  "kind": "generate_sfx",
  "title": "Sound effects (ElevenLabs)",
  "summary": "Makes each requested sound effect with ElevenLabs text-to-sound at a fixed length, one piece per effect.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "filters": [
        "afade"
      ],
      "encoders": [
        "aac"
      ]
    },
    "network": true,
    "models": [
      {
        "provider": "elevenlabs",
        "model": "eleven_text_to_sound_v2"
      }
    ],
    "disk_mb": 20
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "effects"
    ],
    "properties": {
      "effects": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "seconds": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 22
            },
            "prompt_influence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "effects"
    ],
    "properties": {
      "effects": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "audio",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "audio": {
              "type": "object",
              "x-kit-file": {
                "media": "audio"
              }
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "second",
    "measure": {
      "from": "/effects/*/seconds",
      "as": "sum"
    },
    "rates_usd": {
      "eleven_text_to_sound_v2": 0.01
    }
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 15,
    "timeout_s": 600
  },
  "retry": {
    "transient": 1
  },
  "replaces": []
}
