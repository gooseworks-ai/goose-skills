{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "voice-elevenlabs",
  "version": "1.1.0",
  "kind": "generate_voice",
  "title": "Voice (ElevenLabs)",
  "summary": "Speaks each scene's line with an ElevenLabs voice (one narrator, or each cast member's own voice), keeps character timings as word timings, and joins the lines into one voice track.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "filters": [
        "aresample",
        "aformat",
        "atrim",
        "asetpts",
        "apad",
        "concat"
      ],
      "encoders": [
        "aac"
      ]
    },
    "network": true,
    "models": [
      {
        "provider": "elevenlabs",
        "model": "eleven_v3"
      },
      {
        "provider": "elevenlabs",
        "model": "eleven_multilingual_v2"
      }
    ],
    "disk_mb": 50
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "scenes"
    ],
    "properties": {
      "scenes": {
        "description": "The plan's scenes in order. Each scene with a non-empty line is spoken; a null or empty line is skipped and gets no span. With a cast, speaker picks the voice. Other scene fields are ignored.",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "integer"
              ]
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            },
            "speaker": {
              "description": "A cast key. Ignored when no cast is given.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            }
          }
        }
      },
      "cast": {
        "description": "The plan's cast. A scene whose speaker is a member's key is spoken with that member's voice_id (else the default voice_id) and voice_settings (laid over the default ones). A speaker the cast does not hold is refused. Other member fields are ignored.",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "voice_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9]{1,64}$"
            },
            "voice_settings": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "stability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "similarity_boost": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "style": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "use_speaker_boost": {
                  "type": "boolean"
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.7,
                  "maximum": 1.2
                }
              }
            }
          }
        }
      },
      "voice_id": {
        "description": "The default voice: every spoken scene with no cast voice uses it. Optional when the cast gives every spoken scene a voice.",
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Za-z0-9]{1,64}$"
      },
      "model": {
        "description": "eleven_v3 (default) or eleven_multilingual_v2.",
        "enum": [
          "eleven_v3",
          "eleven_multilingual_v2"
        ]
      },
      "tags": {
        "description": "[tag] audio tags in lines: keep sends them to eleven_v3 (the default there); strip takes them out (the default for eleven_multilingual_v2, which refuses keep). Captions never show tags.",
        "enum": [
          "strip",
          "keep"
        ]
      },
      "pronunciations": {
        "description": "The brand's confirmed pronunciations: each term is spoken as say_as; captions keep the written term.",
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": [
            "term",
            "say_as"
          ],
          "properties": {
            "term": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "say_as": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "voice_settings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "similarity_boost": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "style": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "use_speaker_boost": {
            "type": "boolean"
          },
          "speed": {
            "type": "number",
            "minimum": 0.7,
            "maximum": 1.2
          }
        }
      },
      "gap_s": {
        "description": "Silence between lines. Default 0.25.",
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "max_seconds": {
        "description": "Refuse the read when the joined voice track runs longer than this.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "audio",
      "seconds",
      "speech",
      "scenes",
      "lines"
    ],
    "properties": {
      "audio": {
        "type": "object",
        "x-kit-file": {
          "media": "audio"
        }
      },
      "seconds": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "speech": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "start_s",
            "end_s"
          ],
          "properties": {
            "scene_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "spoken": {
              "type": "string"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "start_s",
                  "end_s"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "scenes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "start_s",
            "end_s"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene_id",
            "audio"
          ],
          "properties": {
            "scene_id": {
              "type": "string"
            },
            "audio": {
              "type": "object",
              "x-kit-file": {
                "media": "audio"
              }
            }
          }
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "1k_chars",
    "measure": {
      "from": "/scenes/*/line",
      "as": "length"
    },
    "rates_usd": {
      "eleven_v3": 0.1,
      "eleven_multilingual_v2": 0.1
    },
    "model_from": "/model"
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 30,
    "timeout_s": 900
  },
  "retry": {
    "transient": 1
  },
  "replaces": [
    "create-vo-elevenlabs"
  ]
}
