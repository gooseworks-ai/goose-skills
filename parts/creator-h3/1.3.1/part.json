{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "creator-h3",
  "version": "1.3.1",
  "kind": "generate_video",
  "title": "Talking creator (H3)",
  "summary": "Controlled H3 creator production: generate the first take, review its actual audio and picture, generate remaining takes, then assemble only reviewed sources with real word timings and linked native audio.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.1 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "filters": [
        "silencedetect",
        "tpad",
        "trim",
        "setpts",
        "fps",
        "settb",
        "setsar",
        "format",
        "xfade",
        "concat",
        "aresample",
        "pan",
        "aformat",
        "adelay",
        "apad",
        "atrim",
        "asetpts",
        "acrossfade"
      ],
      "encoders": [
        "libx264",
        "aac",
        "pcm_s16le"
      ]
    },
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "minimax/h3-max/reference-to-video"
      }
    ],
    "disk_mb": 1500
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "scenes",
      "max_seconds",
      "creative_contract_revision"
    ],
    "properties": {
      "creative_contract_revision": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "Checksum of the approved creative contract; provenance stays outside the legacy timeline."
      },
      "generation_stage": {
        "enum": [
          "reviewed_pipeline",
          "first_take",
          "remaining_takes",
          "assemble"
        ],
        "description": "Default reviewed_pipeline selects first trial, remaining candidates or assembly from out-of-band source evidence. Frozen script/capture/model/budget do not change. Explicit stages remain available for capability callers."
      },
      "capture": {
        "enum": [
          "phone_counter",
          "phone_selfie",
          "studio"
        ],
        "description": "Explicit approved recording setup, required in talk mode."
      },
      "qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "shot_type",
          "configuration_sha256",
          "status",
          "accepted_source_sha256",
          "reviewer",
          "audio_listened",
          "video_watched"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "shot_type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "qualified",
              "experimental",
              "suspended"
            ]
          },
          "accepted_source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "audio_listened": {
            "type": "boolean"
          },
          "video_watched": {
            "type": "boolean"
          },
          "conditions": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required_features": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "Required physical action/product features from the approved creative contract; required action checks cannot be not_applicable."
      },
      "accepted_sources": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "video",
            "review",
            "timing_method",
            "words"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_sha256",
                "script_sha256",
                "status",
                "reviewer",
                "coverage",
                "checks"
              ],
              "properties": {
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "script_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "incomplete"
                  ]
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "video_watched",
                    "audio_listened",
                    "start_s",
                    "end_s"
                  ],
                  "properties": {
                    "video_watched": {
                      "type": "boolean"
                    },
                    "audio_listened": {
                      "type": "boolean"
                    },
                    "start_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end_s": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "script",
                    "voice",
                    "lipsync",
                    "identity",
                    "framing",
                    "performance",
                    "product_action"
                  ],
                  "properties": {
                    "script": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "voice": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "lipsync": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "identity": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "framing": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "performance": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    },
                    "product_action": {
                      "enum": [
                        "pass",
                        "fail",
                        "incomplete",
                        "not_applicable"
                      ]
                    }
                  }
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "timing_method": {
              "enum": [
                "reviewed_transcription",
                "forced_alignment"
              ]
            },
            "words": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scene_id",
                  "text",
                  "start_s",
                  "end_s"
                ],
                "properties": {
                  "scene_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "mode": {
        "description": "talk only in this controlled release. Non-speaking clips need a separately qualified route and their own source reviews.",
        "enum": [
          "talk"
        ]
      },
      "scenes": {
        "description": "plan.scenes in order. talk: every non-empty line is said, in order; a scene with no line is skipped. clips: the scenes to pick from.",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "integer",
                "null"
              ]
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 600
            },
            "on_screen": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "picture": {
              "description": "What the scene shows. clips mode: fills {picture}; a leading \"Tag:\" (or extra.shot) is the scene's tag for pick and the template's by_tag.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "image": {
              "description": "A picture the plan shows for this scene: the scene is a cutaway.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "speaker": {
              "description": "A cast key: the creator is this member.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            },
            "extra": {
              "description": "Style fields; extra.shot other than \"creator\" makes the scene a cutaway.",
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "cast": {
        "description": "plan.cast (or an anchor step's cast): the creator is the member the spoken scenes name as speaker, else the first member with a picture. Give cast or character, not both.",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "look": {
              "description": "Age, gender, build, hair, wardrobe: the words that made the picture.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 600
            },
            "gender": {
              "enum": [
                "female",
                "male",
                "nonbinary",
                null
              ]
            },
            "age": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 18,
              "maximum": 90
            },
            "environment": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "delivery": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 300
            },
            "image": {
              "description": "The member's picture (an anchor step fills it). Needed for the creator.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            }
          }
        }
      },
      "character": {
        "description": "The approved creator, when there is no cast: the still, and who they are and where, in the words that made the still (age and gender stated). Never a default person.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "identity"
        ],
        "properties": {
          "image": {
            "type": "object",
            "x-kit-file": {
              "media": "image",
              "mime": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            }
          },
          "identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "environment": {
            "type": "string",
            "maxLength": 1000
          },
          "delivery": {
            "type": "string",
            "maxLength": 600
          },
          "capture": {
            "enum": [
              "phone",
              "studio"
            ]
          },
          "recording": {
            "enum": [
              "counter",
              "selfie"
            ]
          },
          "focus": {
            "enum": [
              "natural",
              "deep",
              "shallow"
            ]
          },
          "distinctive_marks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval": {
            "enum": [
              "pending",
              "approved"
            ]
          }
        }
      },
      "delivery": {
        "description": "How they speak (plan.answers.delivery). Wins over the member's and the character's own delivery.",
        "type": [
          "string",
          "null"
        ],
        "maxLength": 600
      },
      "pronunciations": {
        "description": "brand.pronunciations: each term is said as its say_as. The timeline keeps the written words.",
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": [
            "term",
            "say_as"
          ],
          "properties": {
            "term": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "say_as": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "split_before": {
        "description": "none (default): takes split between any two lines. cutaways: a take may start only at a spoken cutaway scene (extra.shot not \"creator\", a footage entry for the scene, or a scene image), so the join can hide under it; an on-camera run longer than one take is refused.",
        "enum": [
          "none",
          "cutaways"
        ]
      },
      "footage": {
        "description": "plan.footage: an entry's scene_id makes that scene a cutaway.",
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "scene_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          }
        }
      },
      "join": {
        "description": "measured only: use reviewed source word boundaries; silence-detector estimates cannot qualify an assembly.",
        "enum": [
          "measured"
        ]
      },
      "mannerism": {
        "description": "Optional muted motion reference (rights cleared, 2 to 15 s).",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "resolution": {
        "description": "Default 1080P.",
        "enum": [
          "480P",
          "768P",
          "1080P"
        ]
      },
      "aspect_ratio": {
        "description": "Default 9:16.",
        "enum": [
          "21:9",
          "16:9",
          "4:3",
          "1:1",
          "3:4",
          "9:16"
        ]
      },
      "words_per_second": {
        "description": "Speaking rate used to split lines into takes. Default 2.6; above 3.2 (the fastest H3 speaks) it plans at 3.2.",
        "type": "number",
        "minimum": 1.5,
        "maximum": 4
      },
      "max_seconds": {
        "description": "The most seconds of takes (or clips) this step may order (the price is read from it); more is refused.",
        "type": "number",
        "minimum": 5,
        "maximum": 120
      },
      "seed": {
        "description": "Reshuffles every take's seed (a new take is a new price).",
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "video",
      "seconds"
    ],
    "properties": {
      "video": {
        "description": "talk: the creator track. clips: the first clip.",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "seconds": {
        "description": "talk: the reel's length. clips: the clips' lengths added up.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "timeline": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration_s",
          "width",
          "height",
          "fps",
          "scenes",
          "speech"
        ],
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "scene_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start_s",
                      "end_s"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start_s": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "safe_zones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "use": {
                  "enum": [
                    "captions",
                    "logo"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "assembly_timeline": {
        "type": "object",
        "description": "gooseworks-assembly-timeline/1 source clocks, separate from the legacy timeline."
      },
      "provenance": {
        "type": "object",
        "description": "Source checksums, review coverage, linked audio/picture rates, timing method and declared pads; final review remains pending."
      },
      "content_review_status": {
        "enum": [
          "pending",
          "pass",
          "fail"
        ]
      },
      "configuration_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "Exact capture, references, delivery, templates, script and provider-settings configuration qualified by the first reviewed source."
      },
      "review_request": {
        "type": "object",
        "description": "Explicit pending source review for the existing ingredient-review stage; includes actual source files, expected spoken words, checks and qualification configuration."
      },
      "source_files": {
        "type": "array",
        "items": {
          "type": "object",
          "x-kit-file": {
            "media": "video"
          }
        },
        "description": "Actual raw source FileRefs used by the source clocks, including freeze references."
      },
      "takes": {
        "description": "talk: the takes, in order.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "video",
            "start_s",
            "scene_ids"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "scene_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "joins_s": {
              "description": "Every take after the first: the reel second its 0.10 s dissolve from the previous take starts (measured: just after the previous take's last word).",
              "type": "number",
              "minimum": 0
            },
            "script_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "content_review_status": {
              "enum": [
                "pending",
                "pass",
                "fail"
              ]
            },
            "timing_method": {
              "enum": [
                "energy_estimate",
                "reviewed_transcription",
                "forced_alignment"
              ]
            }
          }
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "second",
    "measure": {
      "from": "/max_seconds",
      "as": "value"
    },
    "rates_usd": {
      "minimax/h3-max/reference-to-video": 0.4
    }
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 600,
    "timeout_s": 3600
  },
  "retry": {
    "transient": 1
  },
  "replaces": [
    "create-creator-takes-h3"
  ],
  "x-speech-rate": {
    "words_per_second": {
      "low": 2.3,
      "high": 3.2
    },
    "plans_at_most": 3.2
  }
}
