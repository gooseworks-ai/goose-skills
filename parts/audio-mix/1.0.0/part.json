{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "audio-mix",
  "version": "1.0.0",
  "kind": "mix",
  "title": "Audio mix",
  "summary": "Lays voice, a ducked music bed and timed sound effects under the picture in one pass, balanced and peak-limited.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "filters": [
        "ebur128",
        "sidechaincompress",
        "amix",
        "alimiter",
        "adelay",
        "afade",
        "apad",
        "atrim",
        "aresample",
        "aformat",
        "asplit"
      ],
      "encoders": [
        "aac"
      ]
    },
    "network": false,
    "models": [],
    "disk_mb": 200
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "video"
    ],
    "properties": {
      "video": {
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "voice": {
        "type": "object",
        "x-kit-file": {
          "media": "audio"
        }
      },
      "voice_start_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 300
      },
      "voice_lufs": {
        "description": "Voice level before mixing. Default -16 LUFS.",
        "type": "number",
        "minimum": -30,
        "maximum": -8
      },
      "music": {
        "type": "object",
        "x-kit-file": {
          "media": "audio"
        }
      },
      "music_start_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 300
      },
      "music_lufs": {
        "description": "Bed level between voice lines, before ducking. Default -24 LUFS.",
        "type": "number",
        "minimum": -40,
        "maximum": -8
      },
      "music_fade_in_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "fade_out_seconds": {
        "description": "Fade at the bed's tail. Default 1 s.",
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "duck": {
        "description": "The bed ducks under the voice, or with no voice under the picture's own sound. Default: on when there is a voice. true for the default ducking, false for none, or the settings.",
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "threshold": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "ratio": {
                "type": "number",
                "minimum": 1,
                "maximum": 20
              },
              "attack_ms": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 2000
              },
              "release_ms": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 9000
              }
            }
          }
        ]
      },
      "sfx": {
        "description": "Sound effects placed on the timeline. gain is linear (default 1); max_s cuts a cue so it cannot mask the next.",
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audio",
            "at_s"
          ],
          "properties": {
            "audio": {
              "type": "object",
              "x-kit-file": {
                "media": "audio"
              }
            },
            "at_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 300
            },
            "gain": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "max_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60
            }
          }
        }
      },
      "effects": {
        "description": "A whole effects track laid from 0, not ducked (for example phone-chat's sfx).",
        "type": "object",
        "x-kit-file": {
          "media": "audio"
        }
      },
      "effects_gain": {
        "description": "Linear gain of the effects track. Default 1.",
        "type": "number",
        "minimum": 0,
        "maximum": 4
      },
      "keep_video_audio": {
        "description": "Keep the picture's own sound (never ducked). Default: kept when the picture has sound.",
        "type": "boolean"
      },
      "video_audio_db": {
        "type": "number",
        "minimum": -40,
        "maximum": 20
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "video",
      "seconds"
    ],
    "properties": {
      "video": {
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "seconds": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "cost": {
    "basis": "free"
  },
  "determinism": "pure",
  "timing": {
    "typical_s": 10,
    "timeout_s": 600
  },
  "retry": {
    "transient": 1
  },
  "replaces": [
    "mix-master"
  ]
}
