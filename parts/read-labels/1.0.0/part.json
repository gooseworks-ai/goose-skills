{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "read-labels",
  "version": "1.0.0",
  "kind": "check",
  "title": "Read the product label in a cut",
  "summary": "Reads the large words on the product in frames of a cut against the real product photo, with a vision model, and stops the run when one is misspelled or the label is mirrored, so a garbled label is never called ready.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "encoders": [
        "mjpeg"
      ]
    },
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "openrouter/router/vision"
      }
    ],
    "disk_mb": 50
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "video",
      "timeline",
      "products"
    ],
    "properties": {
      "video": {
        "description": "The cut whose label to read. A check part: the cut is never changed or returned.",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "timeline": {
        "description": "The cut's timeline: two frames are read per scene, the end card left out, at most 16.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration_s",
          "width",
          "height",
          "fps",
          "scenes",
          "speech"
        ],
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "scene_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start_s",
                      "end_s"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start_s": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "safe_zones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "use": {
                  "enum": [
                    "captions",
                    "logo"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "products": {
        "description": "plan.products: the first with a photo is the real label to compare against.",
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            }
          }
        }
      },
      "on_misspelled": {
        "description": "fail (default): a clearly misspelled word on the label stops the run with its frame time and both spellings. report: return what was read and go on.",
        "enum": [
          "fail",
          "report"
        ]
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict",
      "labels"
    ],
    "properties": {
      "verdict": {
        "description": "One check, flag:text_legible, in the check layer's verdict shape: pass, fail (a misspelled word) or not_applicable (the product not seen).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pass",
          "checks",
          "reasons"
        ],
        "properties": {
          "pass": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "status"
              ],
              "properties": {
                "code": {
                  "const": "flag:text_legible"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_applicable"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "found": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check",
                "message"
              ],
              "properties": {
                "check": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "found": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "labels": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "label_words",
          "frames",
          "misspelled",
          "mirrored"
        ],
        "properties": {
          "model": {
            "type": "string"
          },
          "label_words": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "misspelled": {
            "type": "integer",
            "minimum": 0
          },
          "mirrored": {
            "type": "integer",
            "minimum": 0
          },
          "frames": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t_s",
                "scene_id",
                "product_seen",
                "mirrored",
                "words_read",
                "misspelled"
              ],
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "scene_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "product_seen": {
                  "type": "boolean"
                },
                "mirrored": {
                  "type": "boolean"
                },
                "words_read": {
                  "type": "array",
                  "maxItems": 60,
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "misspelled": {
                  "type": "array",
                  "maxItems": 60,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "read",
                      "should_be"
                    ],
                    "properties": {
                      "read": {
                        "type": "string",
                        "maxLength": 200
                      },
                      "should_be": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "call",
    "rates_usd": {
      "openrouter/router/vision": 0.08
    }
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 40,
    "timeout_s": 600
  },
  "retry": {
    "transient": 1
  },
  "replaces": []
}
