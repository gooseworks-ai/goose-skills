{
  "interface": 1,
  "id": "html-frames",
  "version": "1.2.1",
  "kind": "render_html",
  "title": "HTML frames",
  "summary": "Draws a style's frame page with the plan's scenes, products and brand in the kit's Chromium, frame by frame, to H.264; can draw it transparent over another step's video and time scenes by voice or word count.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "assets/sfx/chime.wav",
    "assets/sfx/click.wav",
    "assets/sfx/notify.wav",
    "assets/sfx/pop.wav",
    "assets/sfx/swoosh.wav",
    "assets/sfx/tap.wav",
    "assets/sfx/tick.wav",
    "assets/sfx/whoosh.wav",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": true,
    "ffmpeg": {
      "filters": [
        "scale",
        "setsar",
        "format",
        "transpose",
        "hflip",
        "vflip",
        "overlay",
        "crop",
        "fps",
        "setpts",
        "adelay",
        "amix",
        "volume",
        "apad",
        "atrim"
      ],
      "encoders": [
        "libx264",
        "png",
        "mjpeg",
        "aac",
        "rawvideo",
        "pcm_s16le"
      ]
    },
    "network": false,
    "models": [],
    "disk_mb": 1024
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "template",
      "scenes",
      "aspect",
      "max_words"
    ],
    "oneOf": [
      {
        "required": [
          "duration_s"
        ]
      },
      {
        "required": [
          "scene_s"
        ]
      },
      {
        "required": [
          "pace"
        ]
      },
      {
        "required": [
          "speech"
        ]
      },
      {
        "required": [
          "under"
        ]
      }
    ],
    "properties": {
      "template": {
        "description": "The style's frame page. The maker puts the kit runtime first in its head; the page reads window.kit and draws each frame from kit.render(fn), renderAt(t), seek(ms), or CSS and Web Animations.",
        "type": "object",
        "x-kit-file": {
          "media": "html"
        }
      },
      "frames": {
        "description": "Every other file the page uses (css, js, json, svg, png, jpg, webp), kept at the same places relative to the template. The page can load nothing else.",
        "type": "array",
        "maxItems": 200,
        "items": {
          "anyOf": [
            {
              "type": "object",
              "x-kit-file": {
                "media": "html"
              }
            },
            {
              "type": "object",
              "x-kit-file": {
                "media": "text"
              }
            },
            {
              "type": "object",
              "x-kit-file": {
                "media": "json"
              }
            },
            {
              "type": "object",
              "x-kit-file": {
                "media": "image"
              }
            }
          ]
        }
      },
      "fonts": {
        "description": "The style's fonts (ttf, otf, woff, woff2). CSS uses each by its file name without the extension.",
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "x-kit-file": {
            "media": "font"
          }
        }
      },
      "scenes": {
        "description": "plan.scenes, in order. Each scene's time comes from duration_s or scene_s (shared evenly), pace (by word count), speech (from its first spoken entry) or under_timeline (the video drawn over). kit.scenes carries each one's start_s and end_s, and picture and image as URLs when they are files.",
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "on_screen": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "picture": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "image": {
              "description": "A picture the customer uploaded for this scene, as kit.scenes[i].image (a URL the page can load).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "speaker": {
              "description": "The cast key of who says this scene, as kit.scenes[i].speaker.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "extra": {
              "description": "The style's own scene fields (plan.scenes[].extra), as kit.scenes[i].extra.",
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "max_words": {
        "description": "The style's scenes.max_words. A scene whose line or on-screen text has more words is refused.",
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "products": {
        "description": "plan.products, in the customer's order. A PNG, JPEG or WebP photo over 2048 px on its long side, as shown after its EXIF orientation, reaches the page turned upright and scaled down to 2048 px (a PNG or WebP as PNG, keeping its transparency).",
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            }
          }
        }
      },
      "brand": {
        "description": "The brand frozen at the yes ({\"from\": \"brand\"}): name, logo, colors, fonts (heading, body), cta. Colours become CSS variables (--brand-primary, ...); fonts are brand-heading and brand-body.",
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "logo": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            ]
          },
          "colors": {
            "type": [
              "object",
              "null"
            ]
          },
          "fonts": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "heading": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "x-kit-file": {
                      "media": "font"
                    }
                  }
                ]
              },
              "body": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "x-kit-file": {
                      "media": "font"
                    }
                  }
                ]
              }
            }
          },
          "cta": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "aspect": {
        "enum": [
          "9:16",
          "1:1",
          "4:5",
          "16:9"
        ]
      },
      "duration_s": {
        "description": "Length of the whole video, in seconds. Give this or scene_s.",
        "type": "number",
        "minimum": 0.5,
        "maximum": 180
      },
      "scene_s": {
        "description": "Seconds per scene; the video is this times the number of scenes. Give this or duration_s.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 60
      },
      "fps": {
        "description": "Frames per second. Default 30; drawn over a video (under), that video's own rate, rounded and kept to 1-60.",
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "default": 30
      },
      "short_side": {
        "description": "Pixels on the short side of the video. The page is always laid out at 1080 and scaled.",
        "enum": [
          720,
          1080
        ],
        "default": 1080
      },
      "values": {
        "description": "The style's own plain values for its page (labels, look choices), as kit.values.",
        "type": "object"
      },
      "under": {
        "description": "A video to draw over (another step's video). The page is drawn transparent and laid over it; its sound is kept, the video is as long as it, and the page's size and fps follow the aspect and fps inputs. Needs under_timeline.",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "under_timeline": {
        "description": "The timeline of the video drawn over. kit.scenes take its scene start times by id (in order when no id matches and the counts match); each runs to the next one's start, so a gap between its scenes belongs to the scene before it on the page. When it is one scene (one clip, say) and the plan has several, the plan's scenes share it evenly on whole frames and become this step's scenes; any other count mismatch is refused. Its speech, end_card and safe_zones pass through to this step's timeline. kit.under.quiet_band[i] is the emptiest band of scene i's middle frame.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration_s",
          "width",
          "height",
          "fps",
          "scenes",
          "speech"
        ],
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "scene_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start_s",
                      "end_s"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start_s": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "safe_zones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use",
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "use": {
                  "enum": [
                    "captions",
                    "logo"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "speech": {
        "description": "A voice track timeline's speech (step.<voice>.timeline.speech). Entries pair with scenes by scene_id, or in order when no entry has one and the counts match. Scene 1 starts at 0 and every other scene at its first speech entry; scenes with no speech share the gap before the next scene evenly. The video ends tail_s after the last entry. Passed through to the output timeline and to kit.speech; kit.scenes[i].words lists the words that start in scene i.",
        "type": "array",
        "minItems": 1,
        "maxItems": 400,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "start_s",
            "end_s"
          ],
          "properties": {
            "scene_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "spoken": {
              "type": "string"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "start_s",
                  "end_s"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "tail_s": {
        "description": "Seconds held after the last spoken entry, when scenes are timed by speech. Default 0.",
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "pace": {
        "description": "Each scene holds base_s + per_word_s for each word of its on_screen text (or its line when it has none), kept between min_s and max_s; the last scene holds at least last_min_s. The video is the sum of the holds.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base_s",
          "per_word_s"
        ],
        "properties": {
          "base_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "per_word_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "min_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "max_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "last_min_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          }
        }
      },
      "caption_zone": {
        "description": "Where captions may go, in the page's CSS pixels (1080 on the short side), kept to the page. Reported in the video's pixels (rounded inward) as timeline.safe_zones[use=captions], which the captions layer keeps to; it replaces any caption zone of the video drawn over.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "end_card_scenes": {
        "description": "The last this many scenes are the end card: timeline.end_card spans them to the end, so no caption is drawn over them. Drawn over a video, it replaces that video's end card. 0 adds none.",
        "type": "integer",
        "minimum": 0,
        "maximum": 30
      },
      "skip_blank": {
        "description": "When no scene has on_screen text or a line, the step makes nothing (no video, no timeline) instead of a blank video; the kit then leaves out every reference to its outputs.",
        "type": "boolean"
      },
      "media": {
        "description": "Extra pictures by id (a cast still, a screen), as kit.media [{id, url}].",
        "type": "array",
        "maxItems": 24,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image"
              }
            }
          }
        }
      },
      "footage": {
        "description": "plan.footage, for its windows only: kit.scenes[i].footage lists the scene's entries as {kind, start_s, end_s, crop, fit}. The files are never put in the page (a frame page cannot play video).",
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "properties": {
            "scene_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "kind": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "start_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "end_ms": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "crop": {
              "description": "A source box [x0, y0, x1, y1] in 0..1 of the source, as plan.footage gives it.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                {
                  "type": "object"
                }
              ]
            },
            "fit": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "mask": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 8
            },
            "file": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "video"
                  }
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            }
          }
        }
      },
      "facts": {
        "description": "Measure every PNG, JPEG and WebP picture the page gets into kit.facts[url]: {alpha, plate, accent, luminance, width, height, subject {x, y, w, h, top_cx}} (sizes as 0..1 fractions). An SVG, GIF or AVIF picture gets no entry. Default false.",
        "type": "boolean"
      }
    },
    "allOf": [
      {
        "anyOf": [
          {
            "not": {
              "required": [
                "under"
              ]
            }
          },
          {
            "required": [
              "under_timeline"
            ]
          }
        ]
      },
      {
        "anyOf": [
          {
            "not": {
              "required": [
                "under_timeline"
              ]
            }
          },
          {
            "required": [
              "under"
            ]
          }
        ]
      },
      {
        "anyOf": [
          {
            "not": {
              "required": [
                "tail_s"
              ]
            }
          },
          {
            "required": [
              "speech"
            ]
          }
        ]
      }
    ]
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "video": {
        "description": "H.264 in yuv420p, BT.709, at the aspect's size. Silent, unless it was drawn over a video with sound (that sound is kept as AAC) or the page marked sound cues.",
        "type": "object",
        "x-kit-file": {
          "media": "video",
          "mime": [
            "video/mp4"
          ]
        }
      },
      "seconds": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "timeline": {
        "description": "duration_s, width, height, fps, scenes [{id, start_s, end_s}], the speech it was timed by or drawn over (else empty), end_card when end_card_scenes or the video drawn over has one, and safe_zones: the logo's box (the picture of kit.brand.logo as drawn on the last frame that shows it), the caption zone, and the zones of the video drawn over, all in the video's pixels.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration_s",
          "width",
          "height",
          "fps",
          "scenes",
          "speech"
        ],
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "scene_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start_s",
                      "end_s"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start_s": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
