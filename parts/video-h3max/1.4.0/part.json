{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "video-h3max",
  "version": "1.4.0",
  "kind": "generate_video",
  "title": "Scene clips with native audio (H3 Max)",
  "summary": "H3 Max clips: native dialogue, reference or first/last-frame clips, timed takes, and up to 40 scene stills moved with the voice, incl. silent B-roll with one named action. Clips keep their first frame's light.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": true,
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "minimax/h3-max/reference-to-video"
      }
    ],
    "disk_mb": 1500
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "mode": {
        "description": "Every mode uses minimax/h3-max/reference-to-video. reference (default): a clip from up to 9 images. image_to_video: a clip starting on the given first frame and optionally ending on the last frame. take: up to 4 picked scenes as timed beats in one clip. takes: takes.count takes of up to 8 scenes each, joined into one video. stills: one clip per picked scene (up to 40), starting on that scene's still from a picture step and timed to the voice spans.",
        "enum": [
          "reference",
          "image_to_video",
          "take",
          "takes",
          "stills"
        ],
        "default": "reference"
      },
      "clips": {
        "description": "The hand-built clip list. Without it, give scenes: one clip per picked scene.",
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "prompt": {
              "description": "The structured clip prompt (framing, action, dialogue). It may use the template placeholders ({answers.KEY}, {product.name}, {brand.name}, ...). Without it the template's templates.<clip id>, else its motion, else its scene text is used.",
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "references": {
              "description": "reference mode: reference images in order (the first is Image 1; authored @Image1 tokens are translated): the person, the product, the setting. Never AI-generated video. Without them the template's refs pick them from the plan.",
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image",
                  "mime": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                }
              }
            },
            "start_image": {
              "description": "image_to_video mode: the first frame. \"product\" is the first photo of the product the clip names (else the first product with a photo). Without it the template's refs pick one: the scene's picture, a product photo, a cast member's picture.",
              "anyOf": [
                {
                  "enum": [
                    "product"
                  ]
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image",
                    "mime": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              ]
            },
            "end_image": {
              "description": "image_to_video mode: the last frame. \"start\" lands the clip back on its start frame.",
              "anyOf": [
                {
                  "enum": [
                    "start"
                  ]
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image",
                    "mime": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              ]
            },
            "seconds": {
              "description": "Whole seconds, 4 to 15.",
              "type": "integer",
              "minimum": 4,
              "maximum": 15
            },
            "generate_audio": {
              "description": "Keep native sound (true); false strips it locally after generation.",
              "type": "boolean"
            }
          }
        }
      },
      "seconds": {
        "description": "scenes mode, and mode stills without spans: every clip's length in whole seconds, 4 to 15. Default 5. Modes take and takes: every take's length. Default 15.",
        "type": "integer",
        "minimum": 4,
        "maximum": 15
      },
      "quality_tier": {
        "description": "Standard (default) or Best, the price the customer picked. Sets the default resolution (768P in both; the finished video is scaled to 1080x1920); an explicit value still wins for the whole step.",
        "enum": [
          "standard",
          "best"
        ]
      },
      "resolution": {
        "description": "H3 resolution label. Default 768P (both tiers). 1080P only when the customer asks, sent explicitly. fal makes it from a native 768P take plus a refinement pass.",
        "enum": [
          "480P",
          "768P",
          "1080P"
        ]
      },
      "aspect_ratio": {
        "description": "Default 9:16. adaptive follows the reference canvas.",
        "enum": [
          "adaptive",
          "9:16",
          "16:9",
          "1:1",
          "4:3",
          "3:4",
          "21:9"
        ]
      },
      "generate_audio": {
        "description": "Keep native lip-synced voice and room sound (default true). false strips sound locally; no unsupported generate_audio flag is sent to H3.",
        "type": "boolean"
      },
      "seed": {
        "description": "Mixed into every clip's seed (a style binds plan.answers.take): a new seed is a new piece, so a fix that changes it re-rolls the clips.",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "scenes": {
        "description": "plan.scenes. Without clips: one clip per picked scene (max 12; max 40 in mode stills), keyed by scene id. With clips: a clip whose id is a scene id fills {picture}, {line} and {on_screen} from that scene.",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "on_screen": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "picture": {
              "description": "What the clip shows. A leading \"Tag:\" (or extra.shot) picks the template's by_tag rule.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "image": {
              "description": "A picture the customer gave for this scene: a reference (or the start frame) when the template's refs ask for scene_image.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            },
            "extra": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "template": {
        "description": "The style's prompt template (frames/<name>.prompt.json, version 1; see parts/_lib/prompt.mjs). Its prefix and suffix wrap every clip prompt; its negative is added as \"Avoid: ...\".",
        "type": "object",
        "x-kit-file": {
          "media": "json"
        }
      },
      "look": {
        "description": "A key of the template's looks (a declared plan answer), filling {look}.",
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      },
      "answers": {
        "description": "plan.answers, for {answers.KEY} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "brand": {
        "description": "The brand, for {brand.FIELD} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "cast": {
        "description": "plan.cast. A scene names a member by speaker or by name in its picture or line.",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "look": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 600
            },
            "image": {
              "description": "The member's picture: sent as a reference when a clip names them.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            }
          }
        }
      },
      "products": {
        "description": "plan.products, for {product.name}, start_image \"product\" and product references.",
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            }
          }
        }
      },
      "pick": {
        "description": "scenes mode: which scenes get a clip: all (default), first, with_picture, or {tags: [...]}.",
        "anyOf": [
          {
            "enum": [
              "all",
              "first",
              "with_picture"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tags"
            ],
            "properties": {
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          }
        ]
      },
      "skip_first": {
        "description": "scenes mode: scenes left out at the start of the plan.",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "skip_last": {
        "description": "scenes mode: scenes left out at the end of the plan (an end card scene).",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "takes": {
        "description": "mode takes: how many takes (scenes split by scene.extra.take, else evenly in order) and the template keys for the text of take 1 (first, default \"first\") and of later takes (later, default \"later\", else first's).",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "first": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "later": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          }
        }
      },
      "chain": {
        "description": "mode takes: a still of take 1 (one frame at at_s, default 0.5, cropped to the bottom 45% so no face is in it) is added after the plan references of every later take; takes then run in order.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "crop"
        ],
        "properties": {
          "crop": {
            "enum": [
              "bottom_45"
            ]
          },
          "at_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 15
          }
        }
      },
      "words_per_second": {
        "description": "Modes take and takes: the speaking rate a beat's window is sized from. Default 2.5.",
        "type": "number",
        "minimum": 1,
        "maximum": 4
      },
      "max_words": {
        "description": "Modes take and takes: the most spoken words in one take. Default seconds x words_per_second.",
        "type": "integer",
        "minimum": 1,
        "maximum": 80
      },
      "pronunciations": {
        "description": "Modes take and takes: brand terms written as their spoken form in the dialogue (brand.pronunciations). Default the brand's.",
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "required": [
            "term",
            "say_as"
          ],
          "properties": {
            "term": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "say_as": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "off_screen_lines": {
        "description": "mode take: a line on a beat that keeps the face off screen (a rear-camera, macro or hands shot) is refused (default) or written as voice-over.",
        "enum": [
          "refuse",
          "voiceover"
        ]
      },
      "off_screen_tags": {
        "description": "mode take: the scene tags (extra.shot or a leading \"Tag:\") that keep the face off screen. Default rear, rear-camera, rear-cam, back-camera, macro, hands, off-screen, cutaway, b-roll, broll; a picture that says \"face off-screen\", \"rear camera\" or \"no face\" counts too.",
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "stills": {
        "description": "Mode stills: the scene pictures to move, keyed by scene id (step.<stills>.images). Each is the clip's first frame, fitted to the clip's canvas by cover (centre crop).",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image",
                "mime": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            }
          }
        }
      },
      "spans": {
        "description": "Mode stills: where each scene's line is in the voice or song (step.<voice>.scenes). Each clip is long enough for its scene's time on screen (a scene with no line shares the one before it) plus 0.2 s, rounded up to whole seconds from 4 to 15.",
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "start_s",
            "end_s"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "min_s": {
        "description": "Mode stills: the shortest clip to make.",
        "type": "integer",
        "minimum": 4,
        "maximum": 15
      },
      "max_s": {
        "description": "Mode stills: the longest clip to make. A scene on screen longer than this gets the longest clip, and assemble holds its last frame.",
        "type": "integer",
        "minimum": 4,
        "maximum": 15
      },
      "max_total_s": {
        "description": "Mode stills: a price guard. Refuse the step, before anything is ordered, when all its clips together would be longer than this many seconds.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600
      },
      "fallback": {
        "description": "Mode stills: what a clip the provider refuses or fails becomes. fail (default) fails the step; still hands back its still for that scene (assemble shows it). A plain failure falls back only on the step's last attempt.",
        "enum": [
          "fail",
          "still"
        ]
      },
      "require_scene_tags": {
        "description": "Mode stills: opt in to strict by_tag routing. Reject missing, unknown, malformed or contradictory scene tags before any provider order.",
        "type": "boolean"
      },
      "broll": {
        "description": "Mode stills: silent creator B-roll. Every picked scene names one physical action that changes the picture in extra.action (apply, peel, press, lift, pour, put down, turn to the mirror); a head turn, blink or smile alone is refused. Each prompt adds \"Nobody speaks, lips closed, while <action>.\"; a prompt asking for still hands (\"keep hands still\", \"no hand touches\", \"minimal movement\") is refused. Sound is stripped (generate_audio defaults to false; true is refused).",
        "type": "boolean"
      },
      "end_on_start_tags": {
        "description": "Mode stills: scene tags (extra.shot or a leading \"Tag:\", compared without case or spacing) whose clips must end on their own first frame, sent as end_image_url. For held or shown products: H3 turned a pouch to its back in 3 of 4 unlocked test clips and in none of 4 locked ones (GOOSE-4034).",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "require_product_refs": {
        "description": "Mode stills: opt in to requiring the current real product photo in each product scene's still request, and binding its request evidence to the exact still this clip starts on.",
        "type": "boolean"
      },
      "product_reference_evidence": {
        "description": "Mode stills: the picture step's product request evidence (step.<stills>.product_reference_evidence).",
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "scene_id",
            "image_sha256",
            "product_photos",
            "request_image_sha256",
            "model",
            "piece",
            "digest"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "scene_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "product_photos": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "request_image_sha256": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "model": {
              "type": "string"
            },
            "piece": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "clips"
    ],
    "properties": {
      "clips": {
        "description": "One clip per entry (clips) or per picked scene, id = the scene id (scenes, stills); in modes take and takes, one per take (the same as takes). Mode stills: seconds is the measured length, and a clip that fell back is its still (image) instead of a video.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image"
              }
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "video": {
        "description": "The first clip's video, for one-clip styles (step.<id>.video); absent only in mode stills when the first clip fell back to its still. Modes take and takes: every take joined in order with hard cuts.",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      },
      "takes": {
        "description": "Modes take and takes: one per take in order, id t1, t2, ...",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "video",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "seconds": {
              "type": "integer",
              "minimum": 4,
              "maximum": 15
            }
          }
        }
      },
      "seconds": {
        "description": "Modes take and takes: the joined video's length.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "timeline": {
        "description": "Modes take and takes: the joined video's timeline. scenes are the plan scene ids at their beat windows (estimated); speech is empty, so transcribe the video once.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "duration_s",
          "width",
          "height",
          "fps",
          "scenes",
          "speech"
        ],
        "properties": {
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "speech": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "start_s",
                "end_s"
              ],
              "properties": {
                "scene_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "spoken": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "words": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "start_s",
                      "end_s"
                    ],
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "start_s": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end_s": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "end_card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
