{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "video-seedance-2",
  "version": "1.1.0",
  "kind": "generate_video",
  "title": "Clips with native audio (Seedance 2)",
  "summary": "Short Seedance 2.0 clips on fal, one piece per clip: from reference images (native voice and room sound) or from a start frame such as the product photo, prompts filled from a template.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": true,
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "bytedance/seedance-2.0/reference-to-video"
      },
      {
        "provider": "fal",
        "model": "bytedance/seedance-2.0/image-to-video"
      }
    ],
    "disk_mb": 500
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "mode": {
        "description": "reference (default): bytedance/seedance-2.0/reference-to-video, each clip from up to 9 reference images. image_to_video: bytedance/seedance-2.0/image-to-video, each clip from a start frame (and an optional end frame).",
        "enum": [
          "reference",
          "image_to_video"
        ],
        "default": "reference"
      },
      "clips": {
        "description": "The hand-built clip list (the 1.0.1 behaviour). Without it, give scenes: one clip per picked scene.",
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "prompt": {
              "description": "The structured clip prompt (framing, action, dialogue). It may use the template placeholders ({answers.KEY}, {product.name}, {brand.name}, ...). Without it the template's templates.<clip id>, else its motion, else its scene text is used.",
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "references": {
              "description": "reference mode: reference images in order (the first is @Image1): the person, the product, the setting. Never AI-generated video. Without them the template's refs pick them from the plan.",
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image",
                  "mime": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                }
              }
            },
            "start_image": {
              "description": "image_to_video mode: the first frame. \"product\" is the first photo of the product the clip names (else the first product with a photo). Without it the template's refs pick one: the scene's picture, a product photo, a cast member's picture.",
              "anyOf": [
                {
                  "enum": [
                    "product"
                  ]
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image",
                    "mime": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              ]
            },
            "end_image": {
              "description": "image_to_video mode: the last frame. \"start\" lands the clip back on its start frame.",
              "anyOf": [
                {
                  "enum": [
                    "start"
                  ]
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image",
                    "mime": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              ]
            },
            "seconds": {
              "description": "Whole seconds, 4 to 15.",
              "type": "integer",
              "minimum": 4,
              "maximum": 15
            },
            "generate_audio": {
              "type": "boolean"
            }
          }
        }
      },
      "seconds": {
        "description": "scenes mode: every clip's length in whole seconds, 4 to 15. Default 5.",
        "type": "integer",
        "minimum": 4,
        "maximum": 15
      },
      "resolution": {
        "description": "Default 1080p (better product labels).",
        "enum": [
          "480p",
          "720p",
          "1080p"
        ]
      },
      "aspect_ratio": {
        "description": "Default 9:16.",
        "enum": [
          "9:16",
          "16:9",
          "1:1",
          "4:3",
          "3:4",
          "21:9"
        ]
      },
      "generate_audio": {
        "description": "Native lip-synced voice and room sound. Default true.",
        "type": "boolean"
      },
      "seed": {
        "description": "Mixed into every clip's seed (a style binds plan.answers.take): a new seed is a new piece, so a fix that changes it re-rolls the clips.",
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "scenes": {
        "description": "plan.scenes. Without clips: one clip per picked scene (max 12), keyed by scene id. With clips: a clip whose id is a scene id fills {picture}, {line} and {on_screen} from that scene.",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "on_screen": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "picture": {
              "description": "What the clip shows. A leading \"Tag:\" (or extra.shot) picks the template's by_tag rule.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "image": {
              "description": "A picture the customer gave for this scene: a reference (or the start frame) when the template's refs ask for scene_image.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            },
            "extra": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "template": {
        "description": "The style's prompt template (frames/<name>.prompt.json, version 1; see parts/_lib/prompt.mjs). Its prefix and suffix wrap every clip prompt; its negative is added as \"Avoid: ...\".",
        "type": "object",
        "x-kit-file": {
          "media": "json"
        }
      },
      "look": {
        "description": "A key of the template's looks (a declared plan answer), filling {look}.",
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      },
      "answers": {
        "description": "plan.answers, for {answers.KEY} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "brand": {
        "description": "The brand, for {brand.FIELD} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "cast": {
        "description": "plan.cast. A scene names a member by speaker or by name in its picture or line.",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "look": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 600
            },
            "image": {
              "description": "The member's picture: sent as a reference when a clip names them.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            }
          }
        }
      },
      "products": {
        "description": "plan.products, for {product.name}, start_image \"product\" and product references.",
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            }
          }
        }
      },
      "pick": {
        "description": "scenes mode: which scenes get a clip: all (default), first, with_picture, or {tags: [...]}.",
        "anyOf": [
          {
            "enum": [
              "all",
              "first",
              "with_picture"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tags"
            ],
            "properties": {
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          }
        ]
      },
      "skip_first": {
        "description": "scenes mode: scenes left out at the start of the plan.",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "skip_last": {
        "description": "scenes mode: scenes left out at the end of the plan (an end card scene).",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "clips",
      "video"
    ],
    "properties": {
      "clips": {
        "description": "One clip per entry (clips) or per picked scene, id = the scene id (scenes).",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "video",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "seconds": {
              "type": "integer",
              "minimum": 4,
              "maximum": 15
            }
          }
        }
      },
      "video": {
        "description": "The first clip's video, for one-clip styles (step.<id>.video).",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "second",
    "measure": {
      "from": "/clips/*/seconds",
      "as": "sum"
    },
    "rates_usd": {
      "bytedance/seedance-2.0/reference-to-video": 0.68,
      "bytedance/seedance-2.0/image-to-video": 0.68
    },
    "model_from": "/mode"
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 240,
    "timeout_s": 1800
  },
  "retry": {
    "transient": 1
  },
  "replaces": [
    "create-video-seedance-2-fal"
  ]
}
