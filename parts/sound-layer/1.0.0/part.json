          "name",
          "colors",
          "fonts",
          "pronunciations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "logo": {
            "type": "object",
            "x-kit-file": {
              "media": "image"
            }
          },
          "colors": {
            "type": "object",
            "properties": {
              "primary": {
                "type": "string",
                "maxLength": 64
              },
              "secondary": {
                "type": "string",
                "maxLength": 64
              },
              "background": {
                "type": "string",
                "maxLength": 64
              },
              "text": {
                "type": "string",
                "maxLength": 64
              },
              "palette": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          },
          "fonts": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "object",
                "x-kit-file": {
                  "media": "font"
                }
              },
              "body": {
                "type": "object",
                "x-kit-file": {
                  "media": "font"
                }
              }
            }
          },
          "pronunciations": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "term",
                "say_as"
              ],
              "properties": {
                "term": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "say_as": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "cta": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      },
      "expect": {
        "type": "object",
        "required": [
          "aspect",
          "width",
          "height",
          "duration_s",
          "speech",
          "captions",
          "end_card",
          "qc_flags"
        ],
        "properties": {
          "aspect": {
            "enum": [
              "9:16",
              "1:1",
              "4:5",
              "16:9"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "duration_s": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "speech": {
            "enum": [
              "none",
              "voiceover",
              "on_camera"
            ]
          },
          "captions": {
            "type": "boolean"
          },
          "end_card": {
            "type": "boolean"
          },
          "qc_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "script": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      },
      "words": {
        "type": "object",
        "x-kit-file": {
          "media": "json"
        }
      }
    }
  },
