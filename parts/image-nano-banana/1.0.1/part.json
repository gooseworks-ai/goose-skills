{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "image-nano-banana",
  "version": "1.0.1",
  "kind": "generate_image",
  "title": "Stills (Nano Banana)",
  "summary": "Makes or edits stills with Nano Banana on fal, one piece per image, references passed as files the kit hosts.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": {
      "encoders": [
        "png"
      ]
    },
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "fal-ai/nano-banana"
      },
      {
        "provider": "fal",
        "model": "fal-ai/nano-banana/edit"
      }
    ],
    "disk_mb": 50
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "images"
    ],
    "properties": {
      "model": {
        "description": "fal-ai/nano-banana for a prompt alone, fal-ai/nano-banana/edit with reference images.",
        "enum": [
          "fal-ai/nano-banana",
          "fal-ai/nano-banana/edit"
        ]
      },
      "aspect_ratio": {
        "enum": [
          "21:9",
          "16:9",
          "3:2",
          "4:3",
          "5:4",
          "1:1",
          "4:5",
          "3:4",
          "2:3",
          "9:16"
        ]
      },
      "images": {
        "type": "array",
        "minItems": 1,
        "maxItems": 24,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "references": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image",
                  "mime": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "images"
    ],
    "properties": {
      "images": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image"
              }
            }
          }
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "image",
    "measure": {
      "from": "/images/*",
      "as": "count"
    },
    "rates_usd": {
      "fal-ai/nano-banana": 0.039,
      "fal-ai/nano-banana/edit": 0.039
    },
    "model_from": "/model"
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 25,
    "timeout_s": 900
  },
  "retry": {
    "transient": 1
  },
  "replaces": []
}
