{
  "$schema": "../../_contract/part-manifest.schema.json",
  "interface": 1,
  "id": "video-kling",
  "version": "1.1.0",
  "kind": "generate_video",
  "title": "Moving stills (Kling image-to-video)",
  "summary": "Turns stills into short silent clips with Kling image-to-video on fal, one piece per clip: one clip per plan scene timed to the voice or song, or one per still.",
  "runtime": "node",
  "entry": "part.mjs",
  "files": [
    "README.md",
    "part.mjs"
  ],
  "kit": ">=1.0.0 <2.0.0",
  "needs": {
    "browser": false,
    "ffmpeg": true,
    "network": true,
    "models": [
      {
        "provider": "fal",
        "model": "fal-ai/kling-video/v2.1/standard/image-to-video"
      },
      {
        "provider": "fal",
        "model": "fal-ai/kling-video/v3/standard/image-to-video"
      }
    ],
    "disk_mb": 800
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "model",
      "stills"
    ],
    "properties": {
      "model": {
        "description": "The Kling image-to-video model. v2.1 standard makes 5 or 10 s clips; v3 standard makes 3 to 15 s and is always asked for no sound. Kling 2.5 Turbo was withdrawn in 1.1.0.",
        "enum": [
          "fal-ai/kling-video/v2.1/standard/image-to-video",
          "fal-ai/kling-video/v3/standard/image-to-video"
        ]
      },
      "mode": {
        "description": "scenes: one clip per picked plan scene, its still found by scene id. images: one clip per still. Default: scenes when scenes is given, else images.",
        "enum": [
          "scenes",
          "images"
        ]
      },
      "stills": {
        "description": "The pictures to move, keyed by scene id (step.<stills>.images) or cast key (step.<stills>.anchors).",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "image"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image",
                "mime": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            }
          }
        }
      },
      "scenes": {
        "description": "plan.scenes. scenes mode: the scenes to move. images mode: fills each still's prompt from the scene with its id.",
        "type": "array",
        "minItems": 1,
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "line": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "on_screen": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "picture": {
              "description": "What the scene shows. A leading \"Tag:\" (or extra.shot) picks the template's by_tag rule.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            },
            "speaker": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            },
            "extra": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      },
      "template": {
        "description": "The style's prompt template (frames/<name>.prompt.json, version 1; see parts/_lib/prompt.mjs). Its motion text (or the text `use` names) is each clip's prompt; its negative is the negative prompt.",
        "type": "object",
        "x-kit-file": {
          "media": "json"
        }
      },
      "use": {
        "description": "Which template text is the prompt: motion (default) or a key of the template's templates (\"hook\").",
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "look": {
        "description": "The art style: a key of the template's looks (a declared plan answer), filling {look}.",
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200
      },
      "answers": {
        "description": "plan.answers, for {answers.KEY} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "brand": {
        "description": "The brand, for {brand.FIELD} placeholders.",
        "type": [
          "object",
          "null"
        ]
      },
      "cast": {
        "description": "plan.cast, for {speaker.name}, {speaker.look} and {cast_looks}.",
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,23}$"
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "look": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 600
            },
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "x-kit-file": {
                    "media": "image"
                  }
                }
              ]
            }
          }
        }
      },
      "products": {
        "description": "plan.products, for {product.name}.",
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            },
            "images": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "x-kit-file": {
                  "media": "image"
                }
              }
            }
          }
        }
      },
      "pick": {
        "description": "scenes mode: which scenes move: all (default), first, with_picture, or {tags: [...]}.",
        "anyOf": [
          {
            "enum": [
              "all",
              "first",
              "with_picture"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tags"
            ],
            "properties": {
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            }
          }
        ]
      },
      "skip_first": {
        "description": "scenes mode: scenes left out at the start of the plan.",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "skip_last": {
        "description": "scenes mode: scenes left out at the end of the plan (an end card scene).",
        "type": "integer",
        "minimum": 0,
        "maximum": 40
      },
      "spans": {
        "description": "scenes mode: where each scene's line is in the voice or song (step.<voice>.scenes). Each clip is long enough for its scene's time on screen (a scene with no line shares the one before it) plus 0.2 s, rounded up to a length the model makes.",
        "type": "array",
        "minItems": 1,
        "maxItems": 60,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "start_s",
            "end_s"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "start_s": {
              "type": "number",
              "minimum": 0
            },
            "end_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "seconds": {
        "description": "Without spans: every clip's length, rounded up to a length the model makes. Default 5.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 15
      },
      "min_s": {
        "description": "The shortest clip to make.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 15
      },
      "max_s": {
        "description": "The longest clip to make. A scene on screen longer than this gets the longest clip, and assemble holds its last frame.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 15
      },
      "negative_prompt": {
        "description": "What the clips must not show. Default: the template's negative, else the model's own.",
        "type": "string",
        "minLength": 1,
        "maxLength": 2500
      },
      "cfg_scale": {
        "description": "How closely the clip follows the prompt, 0 to 1. Default: the model's (0.5).",
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "keep": {
        "description": "Keep only this many seconds of every clip, from its start or its end (a 2.3 s reaction hook from a 5 s clip).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seconds",
          "anchor"
        ],
        "properties": {
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 15
          },
          "anchor": {
            "enum": [
              "start",
              "end"
            ]
          }
        }
      },
      "fallback": {
        "description": "What a clip the provider refuses or fails becomes: fail (default) fails the step; still hands back its still for that scene (assemble shows it). A plain failure falls back only on the step's last attempt.",
        "enum": [
          "fail",
          "still"
        ]
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "clips"
    ],
    "properties": {
      "clips": {
        "description": "One per clip, id = the scene id (scenes mode) or the still id (images mode): a silent video, or the still when it fell back.",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "seconds"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "video": {
              "type": "object",
              "x-kit-file": {
                "media": "video"
              }
            },
            "image": {
              "type": "object",
              "x-kit-file": {
                "media": "image"
              }
            },
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "video": {
        "description": "The first clip's video (absent when the first clip fell back to its still).",
        "type": "object",
        "x-kit-file": {
          "media": "video"
        }
      }
    }
  },
  "cost": {
    "basis": "per_unit",
    "unit": "second",
    "rates_usd": {
      "fal-ai/kling-video/v2.1/standard/image-to-video": 0.056,
      "fal-ai/kling-video/v3/standard/image-to-video": 0.14
    },
    "model_from": "/model"
  },
  "determinism": "provider",
  "timing": {
    "typical_s": 300,
    "timeout_s": 3000
  },
  "retry": {
    "transient": 1
  },
  "replaces": []
}
